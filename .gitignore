# Dependencias
node_modules/
.pnpm-store/

# Compilación
dist/
dist-tauri/
src-tauri/target/
# Proyecto Android/iOS generado por `tauri android init` / `tauri ios init`.
src-tauri/gen/

# Certificados y material de firma (NUNCA subir al repositorio)
*.jks
*.keystore
*.base64.txt
*.b64
*.p12
*.pfx
*.gpg
*.tar.gz.gpg
keystore-secrets.txt
keystore.properties
key.properties
# Backups locales de firma (nunca en el repo)
descargas/
backups/
# Clave privada del actualizador (generada con `tauri signer generate`).
# La pública vive en tauri.conf.json; la privada solo en GitHub Secrets.
.tauri/

# Credenciales exportadas de la Snap Store (nunca en el repo).
snap-login.txt
*.snapcraft-credentials

# Artefactos de compilación y descargas de CI
*.apk
*.aab
*.idsig
artifacts/
permissions.txt
manifest-dump.xml
zipalign.txt

# Empaquetado Linux (Snap/Flatpak)
*.snap
*.flatpak
packaging/linux/deb-root/
.flatpak-builder/
flatpak_app/
repo/
parts/
stage/
prime/

# Binarios nativos de PDFium (se obtienen con scripts/fetch-pdfium.sh).
# Se empaquetan como recurso, pero no se versionan para no inflar el repo.
src-tauri/resources/pdfium/*/libpdfium.so
src-tauri/resources/pdfium/*/libpdfium.dylib
src-tauri/resources/pdfium/*/pdfium.dll

# IDEs
.cursor/
.vscode/
