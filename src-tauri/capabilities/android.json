{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "android-updater",
  "description": "Android no puede leer los assets de GitHub Releases con el fetch del WebView porque no envían cabeceras CORS. El plugin HTTP nativo descarga latest.json y el APK; scopeRedirects valida también cada salto contra este allowlist.",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://github.com/wulflo/SinNotas/releases/*"
        },
        {
          "url": "https://api.github.com/repos/wulflo/SinNotas/releases/*"
        },
        {
          "url": "https://objects.githubusercontent.com/*"
        },
        {
          "url": "https://release-assets.githubusercontent.com/*"
        },
        {
          "url": "https://github-releases.githubusercontent.com/*"
        }
      ]
    }
  ]
}
